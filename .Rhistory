group_by(word) |>
summarise(doc_freq = n_distinct(frase_id)) |>
filter(doc_freq > n_frases_total * 0.4)  # aparece en más del 40% de frases → excluir
# DTM sin esas palabras
dtm <- frases_raw |>
unnest_tokens(word, frase) |>
filter(!word %in% stopwords_legales,
!word %in% palabras_frecuentes$word,
nchar(word) > 2) |>
count(frase_id, word) |>
cast_dtm(frase_id, word, n)
