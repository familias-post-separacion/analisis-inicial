# 4a. Tabla de β (palabra → tópico → probabilidad)
beta_tbl <- tidy(modelo_lda, matrix = "beta")   # topic | term | beta
# 4c. Tokenizar frases y unir con β
frase_topic_score <- frases_raw |>
unnest_tokens(word, frase, drop = FALSE) |>
left_join(beta_tbl, by = c("word" = "term"),
relationship = "many-to-many") |>
filter(!is.na(beta)) |>
group_by(doc_id, frase_id, frase, topic) |>
summarise(score = sum(beta), .groups = "drop") |>
# tópico dominante para cada frase
group_by(frase_id) |>
slice_max(score, n = 1, with_ties = FALSE) |>
