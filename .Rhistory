limpiar_texto <- function(texto) {
texto %>%
# HTML tags
str_remove_all("<[^>]+>") %>%
# Encabezados institucionales
str_remove_all("(?i)juzgado de familia[^\n]*") %>%
str_remove_all("(?i)vicuña mackenna[^\n]*") %>%
str_remove_all("(?i)teléfono:[^\n]*") %>%
str_remove_all("(?i)e-mail:[^\n]*") %>%
str_remove_all("(?i)acta audiencia[^\n]*") %>%
str_remove_all("(?i)(ruc|rit|materia|magistrado|consejero técnico|encargado de acta|hora de inicio|hora de término|hora de termino|presentación|fecha)[^\\n\\.]*") %>%
# Códigos de causa
str_remove_all("\\d{2}-\\s*\\d-\\d{7}-\\d") %>%
str_remove_all("(?i)[a-z]-\\d{3,}-\\d{4}") %>%
# ---- NUEVOS PATRONES ----
# Placeholders tipo num000, num001, num123...
str_remove_all("(?i)\\bnum\\d+\\b") %>%
# Placeholders tipo direccion001, direccion002...
str_remove_all("(?i)\\bdireccion\\d+\\b") %>%
# Saltos de línea \n pegados o sueltos (incluyendo múltiples)
str_replace_all("\\n+", " ") %>%
# Montos monetarios: $..-, $.-, $1.234.-
str_remove_all("\\$[\\d\\.\\,\\-]*") %>%
# Comas pegadas a números: ,20256
str_remove_all(",\\d+") %>%
# Puntos y guiones al final de cláusulas: .-  .–
str_remove_all("\\.[-–]") %>%
# Guion largo y similares
str_remove_all("[–—]") %>%
# Numeración romana de items: i.- ii.- iii.- etc.
str_remove_all("(?i)\\b(i{1,3}|iv|vi{0,3}|ix|x)\\.[-–]?\\s*") %>%
# ---- PATRONES ORIGINALES ----
str_remove_all("[➢°•·]") %>%
str_remove_all("[@_]") %>%
str_remove_all("\\b\\d{1,4}\\b") %>%
# Espacios múltiples y limpieza final
str_replace_all("\\s+", " ") %>%
str_trim()
}
corpus_limpio <- textos_pdf |>
purrr::map_chr(\(x) x |> paste(collapse = " ") |> limpiar_texto())
# segmentar por oración
segmentar_por_oraciones <- function(texto, doc_id,
min_palabras = 8,
min_chars    = 40) {
# Corta solo si tras el punto sigue mayúscula (evita abreviaturas)
oraciones <- str_split(texto, "(?<=[.;!?])\\s+(?=[A-ZÁÉÍÓÚÑ])")[[1]]
tibble(
doc_id = doc_id,
frase  = oraciones
) |>
mutate(
frase        = str_trim(frase),
n_palabras   = str_count(frase, "\\S+"),
n_chars      = nchar(frase)
) |>
# Filtros de calidad
filter(
n_palabras >= min_palabras,   # mínimo de palabras
n_chars    >= min_chars,      # mínimo de caracteres
!str_detect(frase, "^[A-ZÁÉÍÓÚÑ\\s]+$"),  # excluye TODO MAYÚSCULAS (títulos)
str_detect(frase, "[aeiouáéíóú]")           # tiene al menos una vocal (descarta siglas sueltas)
) |>
select(doc_id, frase)
}
frases_raw <- map2_dfr(
corpus_limpio,
names(corpus_limpio),
\(texto, id) segmentar_por_oraciones(texto, id, min_palabras = 8, min_chars = 40)
) |>
mutate(frase_id = row_number())
# con tf-idf
# Calcular en cuántas frases aparece cada palabra
n_frases_total <- n_distinct(frases_raw$frase_id)
palabras_frecuentes <- frases_raw |>
unnest_tokens(word, frase) |>
count(frase_id, word) |>
group_by(word) |>
summarise(doc_freq = n_distinct(frase_id)) |>
filter(doc_freq > n_frases_total * 0.4)  # aparece en más del 40% de frases → excluir
# DTM sin esas palabras
dtm <- frases_raw |>
unnest_tokens(word, frase) |>
filter(
!word %in% palabras_frecuentes$word,
nchar(word) > 2) |>
count(frase_id, word) |>
cast_dtm(frase_id, word, n)
k <- 13
