# ID único global para cada frase
mutate(frase_id_global = row_number())
limpiar_minimo <- c(
"<", ">", "<br>", "°", "br",
"direccion000", "direccion001",
"num000", "num001", "rit",
"fecha", "hora"
)
dtm_frases <- frases_df %>%
