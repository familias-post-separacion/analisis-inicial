perplejidad <- map_dbl(valores_k, function(k) {
modelo <- LDA(dtm, k = k, method = "Gibbs",
control = list(seed = 42, iter = 500, burnin = 100))
perplexity(modelo, newdata = dtm)
})
plot(valores_k, perplejidad, type = "b", pch = 19,
xlab = "Número de tópicos (k)",
ylab = "Perplejidad",
main = "Selección de k óptimo (nivel frase)")
k <- 13
modelo_lda <- LDA(dtm, k = K, method = "Gibbs",
control = list(
seed   = 42,
burnin = 500,
iter   = 1000,
thin   = 10,
alpha  = 0.1   # default es 50/K, bajar aumenta especialización
))
modelo_lda <- LDA(dtm, k = k, method = "Gibbs",
control = list(
seed   = 42,
burnin = 500,
iter   = 1000,
thin   = 10,
alpha  = 0.1   # default es 50/K, bajar aumenta especialización
))
# 4a. Tabla de β (palabra → tópico → probabilidad)
beta_tbl <- tidy(modelo_lda, matrix = "beta")   # topic | term | beta
# 4c. Tokenizar frases y unir con β
frase_topic_score <- frases_raw |>
unnest_tokens(word, frase, drop = FALSE) |>
left_join(beta_tbl, by = c("word" = "term"),
relationship = "many-to-many") |>
filter(!is.na(beta)) |>
group_by(doc_id, frase_id, frase, topic) |>
summarise(score = sum(beta), .groups = "drop") |>
# tópico dominante para cada frase
group_by(frase_id) |>
slice_max(score, n = 1, with_ties = FALSE) |>
ungroup()
### topico 1
t1 <- filter(frase_topic_score, topic == 1)
View(t1)
t2 <- filter(frase_topic_score, topic == 2)
View(t2)
gamma_tbl <- tidy(modelo_lda, matrix = "gamma")  # document | topic | gamma
top10_docs <- gamma_tbl |>
group_by(topic) |>
slice_max(gamma, n = 10, with_ties = FALSE) |>
arrange(topic, desc(gamma)) |>
rename(doc_id = document)
View(top10_docs)
