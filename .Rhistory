corpus_limpio <- textos_pdf |>
purrr::map_chr(\(x) x |> paste(collapse = " ") |> limpiar_texto())
# segmentar por oración
segmentar_por_oraciones <- function(texto, doc_id,
min_palabras = 8,
min_chars    = 40) {
# Corta solo si tras el punto sigue mayúscula (evita abreviaturas)
oraciones <- str_split(texto, "(?<=[.;!?])\\s+(?=[A-ZÁÉÍÓÚÑ])")[[1]]
tibble(
doc_id = doc_id,
frase  = oraciones
) |>
mutate(
frase        = str_trim(frase),
n_palabras   = str_count(frase, "\\S+"),
n_chars      = nchar(frase)
) |>
# Filtros de calidad
filter(
n_palabras >= min_palabras,   # mínimo de palabras
n_chars    >= min_chars,      # mínimo de caracteres
!str_detect(frase, "^[A-ZÁÉÍÓÚÑ\\s]+$"),  # excluye TODO MAYÚSCULAS (títulos)
str_detect(frase, "[aeiouáéíóú]")           # tiene al menos una vocal (descarta siglas sueltas)
) |>
select(doc_id, frase)
}
frases_raw <- map2_dfr(
corpus_limpio,
names(corpus_limpio),
\(texto, id) segmentar_por_oraciones(texto, id, min_palabras = 8, min_chars = 40)
) |>
mutate(frase_id = row_number())
View(frases_raw)
# 4a. Tabla de β (palabra → tópico → probabilidad)
beta_tbl <- tidy(modelo_lda, matrix = "beta")   # topic | term | beta
# 4c. Tokenizar frases y unir con β
frase_topic_score <- frases_raw |>
unnest_tokens(word, frase, drop = FALSE) |>
left_join(beta_tbl, by = c("word" = "term"),
relationship = "many-to-many") |>
filter(!is.na(beta)) |>
group_by(doc_id, frase_id, frase, topic) |>
summarise(score = sum(beta), .groups = "drop") |>
# tópico dominante para cada frase
group_by(frase_id) |>
slice_max(score, n = 1, with_ties = FALSE) |>
ungroup()
View(frase_topic_score)
dtm <- frases_raw |>
# tokenizar a palabras por frase
unnest_tokens(word, frase) |>
# quitar stopwords y tokens cortos
filter(!word %in% stopwords_es, nchar(word) > 2) |>
# frecuencia por frase
count(frase_id, word) |>
# DTM donde cada frase es un documento
cast_dtm(frase_id, word, n)
